/*
 * theme_hc.qss.in - the append-only High Contrast override template.
 *
 * Used only under a Windows contrast theme, and always APPENDED after the
 * base template rendered against the contrast palette. It is never used
 * otherwise (high-contrast.md section 2, tokens.md section 12.1).
 *
 * SEED, written 2026-09-28 by lead-designer before MT-025 entered RED.
 *
 * What belongs here: RULE changes, not value changes. The base template
 * already resolves every colour through the High Contrast map, so a rule here
 * exists only where HC needs different behaviour from the same selector.
 *
 * Constraints, all mechanically checked (MT-025 AC-12):
 *   - every selector below appears verbatim in theme.qss.in;
 *   - colours come ONLY from the five palette-role placeholders
 *     Window, WindowText, Highlight, HighlightedText, DisabledText;
 *     no colour token placeholder appears here;
 *   - non-colour tokens such as widths may appear as ordinary placeholders;
 *   - comments in slash-star form only; no nested braces.
 *
 * Do not set border properties on hover or pressed rules here: this sheet is
 * appended, so it would win over the focus ring at equal specificity and focus
 * would stop being additive (A-04, A-15.8).
 */

/* Selected text: WindowText on Highlight is not a pair Windows guarantees. */
QWidget {
    selection-background-color: @{hc.Highlight};
    selection-color: @{hc.HighlightedText};
}

/* e2 under HC: Window plus a 2px WindowText boundary, no shadow. */
QToolTip {
    border: @{border-width.emphasis}px solid @{hc.WindowText};
}

QMenu {
    border: @{border-width.emphasis}px solid @{hc.WindowText};
}

/* e2 under HC for every dialog the sheet styles: Window plus a 2px WindowText
   boundary, no shadow (components.md 10.2, 10.7). A type selector, so every
   QDialog subclass - RerunDialog, BakeConfirmDialog, ApiKeyDialog, QMessageBox -
   takes it. The base sets no dialog border, so this is a rule change (tokens.md
   12.1), not a value change (MT-131). */
QDialog {
    border: @{border-width.emphasis}px solid @{hc.WindowText};
}

/* The over-budget Run again dialog's base hairline (theme.qss.in, MT-127) has
   specificity (0,1,1) over QDialog's (0,0,1) and would stay 1px here. Widen it
   to the same boundary; its colour already resolves to WindowText through the
   token map (components.md 10.9), so only the width is restated (MT-131). */
RerunDialog[overBudget="true"] {
    border-width: @{border-width.emphasis}px;
}

/* The current menu item is the guaranteed pair, inverted. */
QMenu::item:selected {
    background-color: @{hc.Highlight};
    color: @{hc.HighlightedText};
}

/* components.md 10.1: hover is never a ground change under HC. */
QPushButton:hover {
    background-color: @{hc.Window};
}

/* components.md 10.1: pressed is the Highlight pair. */
QPushButton:pressed {
    background-color: @{hc.Highlight};
    color: @{hc.HighlightedText};
}

/* components.md 10.1: disabled label and border are both DisabledText. */
QPushButton:disabled {
    border-color: @{hc.DisabledText};
}

QLineEdit:disabled, QPlainTextEdit:disabled {
    border-color: @{hc.DisabledText};
}

/* A-15.8: focus takes the foreground of the ground it sits on. The primary
   button is the one Highlight-ground focus selector, so its ring is
   HighlightedText, not the WindowText every other ring resolves to. */
QPushButton[variant="primary"]:focus {
    border-color: @{hc.HighlightedText};
}

/* components.md 10.7: the error banner is Window inside a 2px WindowText
   frame with a 3px WindowText leading bar. The base authors these widths as
   hairline and bar in the danger colour; the colour already collapses
   to WindowText through the token map, so this restates the widths (MT-132). */
QFrame#error-banner {
    border: @{border-width.emphasis}px solid @{hc.WindowText};
    border-left: @{border-width.bar}px solid @{hc.WindowText};
}

/* components.md 10.2: the current page row is the Highlight pair. The base
   bar resolves Highlight on Highlight through the token map, so the bar and
   the row's text are restated as the pair's foreground. The glyph rule
   outranks the seven status-colour rules (2,1,1 over 1,1,1) only on the
   current row, so silhouette carries status there (A-15.7, MT-134). */
#pageRow[current="true"] {
    border-left: @{border-width.bar}px solid @{hc.HighlightedText};
    color: @{hc.HighlightedText};
}

#pageRow[current="true"] QLabel#pageGlyph {
    color: @{hc.HighlightedText};
}

#pageRow[current="true"] QLabel#pageLabel {
    color: @{hc.HighlightedText};
}

/* components.md 10.4: the selected translation row is the Highlight pair.
   The base bar resolves Highlight on Highlight through the token map, so the
   bar and the row's text are restated as the pair's foreground, and so are
   the gutter glyph and the ordinal badge (user decision 2026-11-03): the
   glyph rule outranks the six status-colour rules (2,1,1 over 1,1,1) only on
   the selected row, so silhouette carries status there (A-15.7). No hover
   rule: color.surface.hover maps to Window, so hover changes no ground
   (MT-135). */
#translationRow[selected="true"] {
    border-left: @{border-width.bar}px solid @{hc.HighlightedText};
    color: @{hc.HighlightedText};
}

#translationRow[selected="true"] QLabel#rowGutter {
    color: @{hc.HighlightedText};
}

#translationRow[selected="true"] QLabel#rowBadge {
    color: @{hc.HighlightedText};
}
