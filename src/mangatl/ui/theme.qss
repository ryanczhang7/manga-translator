/*
 * theme.qss.in - the base (default, non-High-Contrast) stylesheet template.
 *
 * Source of values: docs/wiki/design/tokens.toml. Every placeholder names a
 * token there. The generator renders this file with the authored values into
 * theme.qss, and copies it verbatim into the package so the running app can
 * re-render it against a High Contrast palette (tokens.md section 12).
 *
 * SEED, written 2026-09-28 by lead-designer before MT-025 entered RED. It
 * covers only the global chrome every widget inherits. Workspace components
 * (components.md sections 2-9) are added by the stories that build them.
 * MT-061 added section 2 (intake and ChapterSummary) and the TranslationRow
 * status gutter, at the end of this file. MT-058 added the CostEstimate
 * rules inside the ChapterSummary block. MT-018 added section 8 (run
 * progress, CostReadout) and the section 9 ErrorBanner, at the end.
 *
 * Rules for editing this file:
 *   - comments in slash-star form only; no nested braces;
 *   - the at-sign appears only in placeholders;
 *   - pixel values are written as a placeholder followed by px;
 *   - no overlay or typeset token belongs here: those are painted from Python;
 *   - no 8-digit colour token belongs here: Qt reads 8-digit hex as AARRGGBB.
 *
 * Focus: QSS has no :focus-visible and no reliable outline, so the ring is a
 * border in the :focus rule (tokens.md section 7, accessibility.md A-13.2).
 * Focus rules set only border properties and hover/pressed rules set only
 * ground and text, so the two are additive (A-04).
 */

/* ---- Ground, text, type, selection ------------------------------------ */

QWidget {
    color: #EDEDED;
    font-family: Segoe UI Variable Text, Segoe UI, sans-serif;
    font-size: 13px;
    font-weight: 400;
    selection-background-color: #17425C;
    selection-color: #EDEDED;
}

QWidget:disabled {
    color: #737373;
}

QMainWindow, QDialog {
    background-color: #1C1C1C;
}

/* ---- Tooltip: elevation e2 -------------------------------------------- */

QToolTip {
    background-color: #2E2E2E;
    color: #EDEDED;
    border: 1px solid #4A4A4A;
    padding: 4px 8px;
}

/* ---- Menu: elevation e2 ----------------------------------------------- */

QMenu {
    background-color: #2E2E2E;
    border: 1px solid #4A4A4A;
    padding: 4px 0px;
}

QMenu::item {
    background-color: transparent;
    color: #EDEDED;
    padding: 8px 12px;
}

/* In a QMenu, :selected is the current item - hover and keyboard alike. */
QMenu::item:selected {
    background-color: #303030;
    color: #EDEDED;
}

QMenu::item:disabled {
    color: #737373;
}

QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 8px;
}

/* ---- Button: components.md section 1, the secondary variant ----------- */
/* The bare rule is secondary; primary follows (MT-059). Ghost and        */
/* destructive still need a selector components.md does not yet name.     */

QPushButton {
    background-color: #262626;
    color: #EDEDED;
    border: 1px solid #7A7A7A;
    border-radius: 4px;
    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #303030;
}

QPushButton:pressed {
    background-color: #3A3A3A;
}

QPushButton:focus {
    border: 2px solid #FFFFFF;
}

QPushButton:disabled {
    background-color: #212121;
    color: #737373;
    border-color: #4A4A4A;
}

/* ---- Button: the primary variant (MT-059, components.md section 1) ---- */
/* The band is transparent at rest and clipped out of the ground, so the  */
/* focus ring lands on the window's ground rather than on the accent, and */
/* focus moves nothing. Each state names the property, so it outranks the */
/* bare rule's state of the same kind.                                    */

QPushButton[variant="primary"] {
    background-color: #4CC2FF;
    color: #06202B;
    border: 2px solid transparent;
    background-clip: padding;
}

QPushButton[variant="primary"]:hover {
    background-color: #7AD3FF;
}

QPushButton[variant="primary"]:pressed {
    background-color: #2FA8E8;
}

QPushButton[variant="primary"]:focus {
    border-color: #FFFFFF;
}

/* ---- Text fields ------------------------------------------------------ */

QLineEdit, QPlainTextEdit {
    background-color: #141414;
    color: #EDEDED;
    border: 1px solid #7A7A7A;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #FFFFFF;
}

QLineEdit:disabled, QPlainTextEdit:disabled {
    background-color: #212121;
    color: #737373;
    border-color: #4A4A4A;
}

/* ---- Item views: list grounds, MT-061 --------------------------------- */
/* Without this an item view's viewport fills from the default palette's  */
/* Base role, white, under the QWidget rule's light text. On a scroll     */
/* area the background property paints the viewport. surface.raised is   */
/* the panel ground of components.md section 3, translation column and    */
/* page strip.                                                            */

QAbstractItemView {
    background-color: #262626;
}

/* ---- Scroll bars: no arrows, a handle that clears 3:1 (A-02) ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #7A7A7A;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    background-color: #7A7A7A;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ====================================================================== */
/* components.md section 2 - chapter intake (MT-061)                      */
/* ====================================================================== */
/*
 * Why every part names its own type size and weight: the QWidget rule above
 * sets font-size and font-weight, and a stylesheet wins over setFont. A part
 * whose size differs from type.body must say so here or it renders at body
 * size. Every selector below carries at least one id, so it outranks the
 * QWidget rule (one type name) and the QWidget:disabled rule (one type name,
 * one pseudo-state) whatever the order of the file.
 *
 * Labels set no ground: a QLabel does not fill its background, so the ground
 * of the region or frame behind it shows through.
 */

/* ---- FolderDropTarget: one rule per value of the dynamic property ----- */
/* state. intake.py mirrors FolderDropTarget.state into it and re-polishes */
/* on every change; the values are exactly empty, hover-valid,             */
/* hover-invalid and error. With no state property nothing matches and no  */
/* region is drawn, so a missing mirror fails visibly.                     */

#folder-drop-target[state="empty"] {
    background-color: #1C1C1C;
    border: 2px dashed #7A7A7A;
    border-radius: 6px;
}

/* DQ-1: the ground is surface.hover, not overlay.fill.hover. */
#folder-drop-target[state="hover-valid"] {
    background-color: #303030;
    border: 2px solid #4CC2FF;
    border-radius: 6px;
}

#folder-drop-target[state="hover-invalid"] {
    background-color: #1C1C1C;
    border: 2px solid #FF7A7A;
    border-radius: 6px;
}

#folder-drop-target[state="error"] {
    background-color: #1C1C1C;
    border: 2px solid #FF7A7A;
    border-radius: 6px;
}

/* Focus, A-04. The region has one border, so in the two resting states   */
/* the ring takes it. One id, one attribute, one pseudo-state: it outranks */
/* the state rules above regardless of order. It does not match the two   */
/* hover states, so drag feedback is never hidden by focus. components.md  */
/* section 2, Focus.                                                       */
#folder-drop-target[state="empty"]:focus,
#folder-drop-target[state="error"]:focus {
    border: 2px solid #FFFFFF;
}

#folder-drop-target QLabel#headline {
    color: #EDEDED;
    font-size: 20px;
    font-weight: 600;
}

#folder-drop-target QLabel#body {
    color: #B4B4B4;
    font-size: 13px;
    font-weight: 400;
}

/* The affordance label takes no rule of its own: the QWidget rule gives  */
/* it type.body in color.text.primary. components.md section 2.           */

/* ---- ChapterSummary --------------------------------------------------- */
/* Spacing between parts and the notice padding are layout, set in        */
/* summary.py from space tokens; nothing here sets margin or padding.     */
/* The same holds for the cost estimate's inset (cost_estimate.py).       */

#chapter-summary QLabel#summary-name {
    color: #EDEDED;
    font-size: 16px;
    font-weight: 600;
}

#chapter-summary QLabel#summary-count {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 400;
}

#chapter-summary QLabel#summary-first,
#chapter-summary QLabel#summary-last,
#chapter-summary QLabel#summary-only {
    color: #B4B4B4;
    font-size: 13px;
    font-weight: 400;
}

#chapter-summary QFrame#summary-order-notice {
    background-color: #262626;
    border: 1px solid #FFC14D;
    border-radius: 4px;
}

#chapter-summary QLabel#order-lead {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 600;
}

#chapter-summary QLabel#order-natural,
#chapter-summary QLabel#order-lexical {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 400;
}

/* ---- CostEstimate: ChapterSummary part 5 (MT-058) --------------------- */
/* Ground as the order notice. No padding: the space.3 inset is layout,   */
/* set in cost_estimate.py, as for the notice. Two states, one border      */
/* width, so the state moves nothing. The over-budget state is the        */
/* dynamic property overBudget, a bool that cost_estimate.py sets once,    */
/* before the frame is first polished, and never changes; Qt matches a    */
/* bool property against the string true. The over-budget rule is two ids, */
/* one attribute, one type name, so it outranks the normal rule whatever  */
/* the order of the file. Colour is emphasis only: the sentence on the    */
/* budget line carries the state (A-10).                                  */

#chapter-summary QFrame#summary-cost-estimate {
    background-color: #262626;
    border: 1px solid #333333;
    border-radius: 4px;
}

#chapter-summary QFrame#summary-cost-estimate[overBudget="true"] {
    border: 1px solid #FFC14D;
}

#chapter-summary QLabel#cost-estimate {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 600;
}

#chapter-summary QLabel#cost-budget {
    color: #B4B4B4;
    font-size: 13px;
    font-weight: 400;
}

#chapter-summary QLabel#cost-page-warning {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 400;
}

/* The scroll area is the summary's reading stop. Its border is always    */
/* focus.width wide, transparent at rest, so taking focus repaints the    */
/* ring without moving any line of text.                                  */
#chapter-summary QScrollArea#summary-scroll {
    background-color: #1C1C1C;
    border: 2px solid transparent;
}

#chapter-summary QScrollArea#summary-scroll:focus {
    border: 2px solid #FFFFFF;
}

/* The scroll area's content widget. QScrollArea.setWidget turns on its    */
/* autoFillBackground, and it fills from the default palette, which a      */
/* stylesheet background on an ancestor does not reach: without this rule  */
/* the summary paints Qt's light grey under color.text.primary. The        */
/* content widget has no object name; qt_scrollarea_viewport is the name   */
/* QAbstractScrollArea gives its viewport. The two child steps match the   */
/* content widget only - never the labels, the notice or the scroll bars.  */
#chapter-summary QScrollArea#summary-scroll > QWidget#qt_scrollarea_viewport > QWidget {
    background-color: #1C1C1C;
}

/* ====================================================================== */
/* components.md section 5 - TranslationRow status gutter (MT-061)        */
/* ====================================================================== */
/* Only because the QWidget rule's color would otherwise replace the      */
/* gutter's setPalette colour (a stylesheet wins over a palette). Keyed   */
/* on the existing status property; workspace.py re-polishes the gutter   */
/* after setting it. Tokens are workspace.STATUS_COLOR_TOKENS. Not a      */
/* section 5 redesign: the rest of the row is a later story.             */

QLabel#rowGutter[status="proposed"] {
    color: #949494;
}

QLabel#rowGutter[status="accepted"] {
    color: #6FD08C;
}

QLabel#rowGutter[status="edited"] {
    color: #4CC2FF;
}

QLabel#rowGutter[status="reverted"] {
    color: #B4B4B4;
}

QLabel#rowGutter[status="failed"] {
    color: #FF7A7A;
}

/* ====================================================================== */
/* components.md section 8 - run progress and CostReadout (MT-018)        */
/* ====================================================================== */
/* Colour only. The type that section 8 names - type.numeric and     */
/* type.numeric-lead in family.mono, type.caption - is NOT set yet:   */
/* every token it would reference is an orphan today, and             */
/* tests/ui/test_tokens.py pins the referenced and orphan counts      */
/* (39, 87): adding them is a RED change to those two constants.     */
/* Until then these labels take the QWidget rule: type.body.          */
/* Spacing is layout, set in progress.py and cost_readout.py.         */

#run-progress QProgressBar#run-overall {
    background-color: #141414;
    border: none;
    border-radius: 4px;
}

#run-progress QProgressBar#run-overall::chunk {
    background-color: #4CC2FF;
    border-radius: 4px;
}

/* ---- RunThumbnail (MT-062): the current page, markers drawn on it ----- */
/* Ground and 1 px frame only; radius 0. The page image and the markers   */
/* are painted by run_thumbnail.py inside the 1 px-inset content box.     */

#run-thumbnail {
    background-color: #141414;
    border: 1px solid #333333;
}

/* ---- PageStageStepper: one rule per value of the dynamic property ----- */
/* stepState, which progress.py sets on each step label and re-polishes.  */
/* The text carries the state too (a check when done, a marker when       */
/* active), so colour is never the only carrier (A-10).                    */

QLabel#stage-step[stepState="pending"] {
    color: #949494;
}

QLabel#stage-step[stepState="active"] {
    color: #4CC2FF;
}

QLabel#stage-step[stepState="done"] {
    color: #6FD08C;
}

/* ---- CostReadout: keyed on the dynamic property costState ------------- */
/* cost_readout.py mirrors CostReadout.state() into costState on the       */
/* readout and re-polishes the readout, the figure, the glyph and the      */
/* meter on every change. Every state rule is two ids and one attribute,  */
/* so it outranks the resting rule whatever the order of the file. The    */
/* glyph and the text carry the state; colour is emphasis (A-10).         */

#cost-readout QLabel#cost-figure {
    color: #EDEDED;
}

#cost-readout QLabel#cost-budget-label {
    color: #949494;
}

#cost-readout QLabel#cost-projection {
    color: #B4B4B4;
}

#cost-readout QLabel#cost-glyph {
    color: #FFC14D;
}

#cost-readout QProgressBar#cost-meter {
    background-color: #141414;
    border: none;
}

#cost-readout QProgressBar#cost-meter::chunk {
    background-color: #949494;
}

#cost-readout[costState="unknown"] QProgressBar#cost-meter {
    border: 1px solid #4A4A4A;
}

#cost-readout[costState="approaching"] QProgressBar#cost-meter::chunk {
    background-color: #FFC14D;
}

#cost-readout[costState="exceeded"] QLabel#cost-figure,
#cost-readout[costState="exceeded"] QLabel#cost-glyph {
    color: #FF7A7A;
}

#cost-readout[costState="exceeded"] QProgressBar#cost-meter::chunk,
#cost-readout[costState="aborted"] QProgressBar#cost-meter::chunk {
    background-color: #FF7A7A;
}

/* ====================================================================== */
/* components.md section 9 - ErrorBanner (MT-018)                         */
/* ====================================================================== */
/* The danger variant, the only one built so far. The leading bar is      */
/* border-width.emphasis: section 9 says 3px and no token holds 3.        */

QFrame#error-banner {
    background-color: #262626;
    border: 1px solid #FF7A7A;
    border-left: 2px solid #FF7A7A;
    border-radius: 4px;
}

QFrame#error-banner QLabel#banner-glyph {
    color: #FF7A7A;
}

QFrame#error-banner QLabel#banner-headline {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 600;
}

QFrame#error-banner QLabel#banner-body {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 400;
}
