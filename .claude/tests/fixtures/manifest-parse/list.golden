format       optional  .      uv run ruff format --check .
                              evidence: [1-9][0-9]* files? (already formatted|would be reformatted)
lint         required  .      uv run ruff check --no-cache . && uv run ruff check --no-cache --show-files . | grep -qE "src.mangatl.*[.]py" && uv run lint-imports
                              evidence: Contracts: [1-9][0-9]* kept
                              floor:    5
typecheck    required  .      uv run mypy src
                              evidence: Success: no issues found in [1-9][0-9]* source file
                              floor:    44
unit         required  .      uv run pytest -q tests/core tests/ui
                              evidence: [1-9][0-9]* passed
                              floor:    529
                              covers:   src/mangatl/**
coverage     required  .      uv run pytest -q tests/core tests/ui --cov=src/mangatl --cov-report=term-missing --cov-fail-under=90
                              evidence: [1-9][0-9]* passed
                              floor:    529
                              covers:   src/mangatl/**
coverage-core required  .      uv run pytest -q tests/core --cov=src/mangatl/domain --cov=src/mangatl/typeset --cov=src/mangatl/bench --cov-report=term-missing --cov-fail-under=100
                              evidence: [1-9][0-9]* passed
                              floor:    524
                              covers:   src/mangatl/domain/**
                              covers:   src/mangatl/typeset/**
                              covers:   src/mangatl/bench/**
integration  optional  .      uv run pytest -q tests/integration -m "gpu or network"
                              evidence: [1-9][0-9]* passed
                              floor:    26
                              covers:   src/mangatl/detect/**
                              covers:   src/mangatl/ocr/**
                              covers:   src/mangatl/clean/**
                              blocked-when: (CUDAExecutionProvider is not in available provider names|Failed to load library .*onnxruntime_providers_cuda|no CUDA-capable device)
                              skipped-when: [1-9][0-9]* skipped
                              slow:     loads real .onnx models onto the GPU and calls a paid API (left out of --fast)
build        required  .      uv run pyinstaller --noconfirm packaging/mangatl.spec
                              evidence: Building EXE from|completed successfully
                              covers:   packaging/**
                              slow:     PyInstaller freezes an interpreter and later ~1 GB of weights; 34 s at MT-001 with PySide6 alone, minutes once the weights land (left out of --fast)
mutation     optional  .      uv run mutmut run
                              evidence: <none>
                              waiver:   mutmut is not installed and not configured until the suite is real; stack.md §6
                              slow:     re-runs the suite once per mutant (left out of --fast)
